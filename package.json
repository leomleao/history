{
  "name": "panzonato-exhibition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-catalog.mjs && astro check && astro build && node scripts/validate-output.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:validate": "node scripts/validate-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.6",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  }
}
