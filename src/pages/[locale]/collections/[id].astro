---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EvidenceDialog from '../../../components/EvidenceDialog.astro';
import MediaImage from '../../../components/MediaImage.astro';
import { getChapters, getHistoricalCollections, locales, otherLocale, route, type Locale } from '../../../lib/content';
import { exhibitionPayload, safeJson, strings } from '../../../lib/ui';

export function getStaticPaths() {
  return locales.flatMap(locale => getHistoricalCollections(locale).map(collection => ({ params: { locale, id: collection.id }, props: { locale, collection } })));
}
const { locale, collection } = Astro.props as { locale: Locale; collection: ReturnType<typeof getHistoricalCollections>[number] };
const t = strings(locale);
const collections = getHistoricalCollections(locale);
const index = collections.findIndex(item => item.id === collection.id);
const previous = collections[(index - 1 + collections.length) % collections.length];
const next = collections[(index + 1) % collections.length];
const chapter = (await getChapters(locale)).find(item => item.data.key === collection.chapterKey);
const essayMedia = collection.media.filter(item => item.id !== collection.cover.id);
---

<BaseLayout locale={locale} title={collection.title} description={collection.description} alternateHref={route(otherLocale(locale), 'collections', collection.id)} current="collections">
  <article class="collection-detail">
    <header class="collection-hero">
      <Breadcrumbs label={t.breadcrumbLabel} items={[{ label: t.breadcrumbHome, href: route(locale) }, { label: t.allCollections, href: route(locale, 'collections') }, { label: collection.title }]} />
      <div><span class="eyebrow">{collection.period} · {collection.media.length} {t.photographs}</span><h1>{collection.title}</h1><p>{collection.description}</p>{chapter && <a class="text-link" href={chapter.href}>{t.relatedChapter}<span aria-hidden="true"></span></a>}</div>
      <figure><a class="image-open" href={collection.cover.href} data-evidence={collection.cover.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${collection.cover.title}`}><MediaImage media={collection.cover} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 58vw, 100vw" /></a><figcaption>{collection.cover.caption}</figcaption></figure>
    </header>
    <section class="collection-essay" aria-labelledby="collection-essay-title">
      <div class="collection-essay-heading"><span class="eyebrow">{t.collection}</span><h2 id="collection-essay-title">{t.collectionEssay}</h2></div>
      <div class="essay-grid">{essayMedia.map((media, mediaIndex) => <figure class={`essay-item-${mediaIndex + 1}`}><a class="image-open" href={media.href} data-evidence={media.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${media.title}`}><MediaImage media={media} sizes="(min-width: 900px) 48vw, 100vw" /></a><figcaption><span>{String(mediaIndex + 2).padStart(2, '0')} / {media.caption}</span><a href={media.href}>{t.sourceRecord}</a></figcaption></figure>)}</div>
    </section>
    <nav class="discovery-nav" aria-label={t.allCollections}>{previous && <a href={previous.href}><span>{t.previousCollection}</span><strong>{previous.title}</strong></a>}{next && <a href={next.href}><span>{t.nextCollection}</span><strong>{next.title}</strong></a>}</nav>
  </article>
  <EvidenceDialog locale={locale} initial={collection.cover} />
  <script id="exhibition-data" type="application/json" is:inline set:html={safeJson(exhibitionPayload(locale, collection.media))}></script>
</BaseLayout>
