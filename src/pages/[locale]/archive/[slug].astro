---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EvidenceDialog from '../../../components/EvidenceDialog.astro';
import MediaImage from '../../../components/MediaImage.astro';
import { getChapters, getSources, locales, otherLocale, route, type Locale } from '../../../lib/content';
import { exhibitionPayload, safeJson, strings } from '../../../lib/ui';

export function getStaticPaths() {
  return locales.flatMap((locale) => getSources(locale).map((source) => ({ params: { locale, slug: source.id }, props: { locale, source } })));
}
const { locale, source } = Astro.props as { locale: Locale; source: ReturnType<typeof getSources>[number] };
const t = strings(locale);
const chapters = (await getChapters(locale)).filter((chapter) => chapter.data.sourceIds.includes(source.id));
---

<BaseLayout locale={locale} title={source.title} description={source.description} alternateHref={route(otherLocale(locale), 'archive', source.id)} current="archive">
  <article class="record-detail source-detail">
    <header class="page-intro">
      <Breadcrumbs label={t.breadcrumbLabel} items={[{ label: t.breadcrumbHome, href: route(locale) }, { label: t.allSources, href: route(locale, 'archive') }, { label: source.title }]} />
      <span class="eyebrow">{t.source}</span>
      <h1>{source.title}</h1>
      <p>{source.description}</p>
    </header>
    <div class:list={['source-layout', { 'without-image': !source.media }]}>
      {source.media && <figure class="source-image">
        <a class="image-open" href={source.media.src} data-evidence={source.media.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${source.title}`}>
          <MediaImage media={source.media} sizes="(min-width: 900px) 62vw, 100vw" loading="eager" />
        </a>
        <figcaption>{source.media.caption}</figcaption>
      </figure>}
      {!source.media && <div class="source-text-record"><span class="eyebrow">{t.sourceKinds[source.kind]} · {source.date}</span><h2>{source.title}</h2><p>{source.citation}</p>{source.locator && <a class="text-link" href={source.locator}>{t.timelineSource}<span aria-hidden="true"></span></a>}</div>}
      <dl class="source-metadata">
        <div><dt>{t.recordType}</dt><dd>{t.sourceKinds[source.kind]}</dd></div>
        <div><dt>{t.repository}</dt><dd>{source.repository}</dd></div>
        <div><dt>{t.locator}</dt><dd>{source.locator ? <a href={source.locator}>{source.locator}</a> : '—'}</dd></div>
        <div><dt>{t.citation}</dt><dd>{source.citation}</dd></div>
        {source.media && <><div><dt>{t.imageCredit}</dt><dd>{source.media.credit}</dd></div><div><dt>{t.rights}</dt><dd>{source.media.rights}</dd></div></>}
      </dl>
    </div>
    {(source.transcript || source.evidenceNote) && <section class="record-reading">
      {source.transcript && <div><span class="eyebrow">{t.transcriptTitle}</span><blockquote>{source.transcript}</blockquote></div>}
      {source.evidenceNote && <details><summary>{t.evidenceNoteTitle}</summary><p>{source.evidenceNote}</p></details>}
    </section>}
    {chapters.length > 0 && <section class="related-records">
      <span class="eyebrow">{t.connectedChapters}</span>
      <div class="record-grid compact">{chapters.map((chapter) => <article class="record-card"><h2><a href={chapter.href}>{chapter.data.title}</a></h2><p>{chapter.data.summary}</p></article>)}</div>
    </section>}
  </article>
  {source.media && <><EvidenceDialog locale={locale} initial={source.media} /><script id="exhibition-data" type="application/json" is:inline set:html={safeJson(exhibitionPayload(locale, [source.media]))}></script></>}
</BaseLayout>
