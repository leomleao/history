---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SourceCard from '../../../../components/SourceCard.astro';
import EvidenceDialog from '../../../../components/EvidenceDialog.astro';
import MediaImage from '../../../../components/MediaImage.astro';
import { getChapters, getMedia, getPeople, getSources, locales, otherLocale, route, type Locale, type MediaView } from '../../../../lib/content';
import { getPersonStory } from '../../../../data/person-stories';
import { exhibitionPayload, safeJson, strings } from '../../../../lib/ui';

export async function getStaticPaths() {
  return locales.flatMap((locale) => getPeople(locale).map((person) => ({ params: { locale, slug: person.id }, props: { locale, person } })));
}
const { locale, person } = Astro.props as { locale: Locale; person: ReturnType<typeof getPeople>[number] };
const t = strings(locale);
const chapters = (await getChapters(locale)).filter((chapter) => person.chapterKeys.includes(chapter.data.key));
const sources = getSources(locale).filter((source) => person.sourceIds.includes(source.id));
const media = sources.map(source => source.media).filter((m): m is MediaView => !!m);
const story = getPersonStory(person.id, locale);
const storySections = story?.sections.map(section => ({ ...section, media: getMedia(section.mediaId, locale), relatedMedia: section.relatedMediaIds?.map(id => getMedia(id, locale)) ?? [] })) ?? [];
const pageMedia = [...new Map([...media, ...storySections.flatMap(section => [section.media, ...section.relatedMedia])].map(item => [item.id, item])).values()];
const people = getPeople(locale);
const connections = person.relationships.map(relation => ({ ...relation, person: people.find(p => p.id === relation.personId) }));
---

<BaseLayout locale={locale} title={person.name} description={person.summary} alternateHref={route(otherLocale(locale), 'people', person.id)} current="people">
  <article class="record-detail person-detail">
    <header class="page-intro">
      <Breadcrumbs label={t.breadcrumbLabel} items={[{ label: t.breadcrumbHome, href: route(locale) }, { label: t.allPeople, href: route(locale, 'people') }, { label: person.name }]} />
      <span class="eyebrow">{t.profile}{person.dates ? ` · ${person.dates}` : ''}</span>
      <h1>{person.name}</h1>
      <p>{person.summary}</p>
      {person.aliases.length > 0 && <p class="aliases"><span>{t.namesAlsoRecorded}</span> {person.aliases.join(', ')}</p>}
    </header>
    {story ? <div class="profile-story">
      <p class="profile-story-note">{story.note}</p>
      {storySections.map((section, index) => <section class="profile-story-section" data-evidence-tone={section.evidence} data-layout={section.relatedMedia.length ? 'document' : undefined}>
        <figure>
          <div class="profile-story-image-frame">
            <a class="image-open" href={section.media.href} data-evidence={section.media.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${section.media.title}`} style={`--media-aspect: ${section.media.width} / ${section.media.height}`}>
              <MediaImage media={section.media} sizes={section.relatedMedia.length ? '(min-width: 768px) 92vw, 44rem' : '(min-width: 1000px) 47vw, 94vw'} />
            </a>
          </div>
          <figcaption>{section.media.caption}</figcaption>
          {section.relatedMedia.length > 0 && <p class="profile-story-swipe-hint">{locale === 'pt-br' ? 'No celular, deslize a imagem para ler toda a linha manuscrita.' : 'On a phone, swipe the image to read the whole handwritten line.'}</p>}
          {section.relatedMedia.length > 0 && <div class="profile-story-companions" aria-label={locale === 'pt-br' ? 'Documentos relacionados' : 'Related documents'}>
            {section.relatedMedia.map((related) => <a href={related.href}>
              <MediaImage media={related} sizes="(min-width: 768px) 11rem, 35vw" />
              <span>{related.title}</span>
            </a>)}
          </div>}
        </figure>
        <div>
          <span class="eyebrow">{String(index + 1).padStart(2, '0')} · {section.eyebrow}</span>
          <h2>{section.title}</h2>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </section>)}
    </div> : <div class="prose profile-biography">{person.biography.map((paragraph) => <p>{paragraph}</p>)}</div>}
    {connections.length > 0 && <section class="related-records family-connections"><span class="eyebrow">{t.familyConnections}</span><div class="connection-grid">{connections.map(connection => connection.person && <a href={connection.person.href}><span>{connection.label}</span><h2>{connection.person.name}</h2><p>{connection.person.dates}</p></a>)}</div></section>}
    {chapters.length > 0 && <section class="related-records">
      <span class="eyebrow">{t.connectedChapters}</span>
      <div class="record-grid compact">{chapters.map((chapter) => <article class="record-card chapter-card"><a href={chapter.href}><MediaImage media={chapter.media} sizes="(min-width: 900px) 24vw, 90vw" /><div><h2>{chapter.data.title}</h2><p>{chapter.data.question}</p></div></a></article>)}</div>
    </section>}
    {sources.length > 0 && <section class="related-records">
      <span class="eyebrow">{t.relatedEvidence}</span>
      <div class="record-grid compact">{sources.map(source => <SourceCard source={source} locale={locale} />)}</div>
    </section>}
  </article>
  {pageMedia[0] && <><EvidenceDialog locale={locale} initial={pageMedia[0]} /><script id="exhibition-data" type="application/json" is:inline set:html={safeJson(exhibitionPayload(locale, pageMedia))}></script></>}
</BaseLayout>
