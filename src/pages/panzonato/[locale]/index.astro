---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceDialog from '../../../components/EvidenceDialog.astro';
import MediaImage from '../../../components/MediaImage.astro';
import Timeline from '../../../components/Timeline.astro';
import VoyageMap from '../../../components/VoyageMap.astro';
import { getAllMedia, getChapters, getFeatures, getHistoricalCollections, getMedia, getPeople, getSources, locales, otherLocale, route, type Locale } from '../../../lib/content';
import { exhibitionPayload, safeJson, strings } from '../../../lib/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = strings(locale);
const chapters = await getChapters(locale);
const people = getPeople(locale);
const media = getAllMedia(locale);
const mediaById = Object.fromEntries(media.map(item => [item.id, item]));
const hero = getMedia('genoa', locale);
const initialChapter = chapters[0]!;
const initialMedia = initialChapter.media;
const crossing = chapters.find(chapter => chapter.data.key === 'crossing')!;
const pt = locale === 'pt-br';
const stageItems = [
  { key: 'port', country: pt ? '01 / O mar' : '01 / The sea', name: pt ? 'Gênova' : 'Genoa', mediaId: 'genoa-emigrant-embarkation-1898', eyebrow: pt ? 'Um mundo em movimento' : 'A world in motion', title: pt ? 'O porto das partidas.' : 'The port of departures.', copy: pt ? 'Famílias, bagagens e uma prancha de embarque. Esta fotografia de 1898 mostra o movimento migratório em Gênova, um dos portos da rota do Colombo. É contexto da época; o registro familiar não informa onde os Panzonato embarcaram.' : 'Families, luggage, and a gangplank. This 1898 photograph opens onto migration through Genoa, one of the Colombo’s regular ports. It is a view of the wider story; the family record does not name their port of embarkation.' },
  { key: 'hostelry', country: pt ? '02 / A chegada' : '02 / Arrival', name: 'São Paulo', mediaId: 'immigrants-at-bras-courtyard', eyebrow: '15.12.1891', title: pt ? 'Oito nomes no livro.' : 'Eight names in the ledger.', copy: pt ? 'Giuseppe, Fosca e seis crianças aparecem juntos no registro da Hospedaria de Imigrantes. O vapor é o Colombo. A procedência: Rio de Janeiro. O destino anotado: Tietê. São os pontos de partida para reconstruir a vida no Brasil.' : 'Giuseppe, Fosca, and six children appear together in the immigrant register. The ship: Colombo. Proceeding from: Rio de Janeiro. Destination: Tietê. These are the written clues from which their life in Brazil can be traced.' },
  { key: 'capivari', country: pt ? '03 / Uma nova geração' : '03 / A new generation', name: 'Capivari', mediaId: 'capivari-station-1981', eyebrow: pt ? 'O interior paulista' : 'Inland São Paulo', title: pt ? 'Uma história que cria raízes.' : 'A story that takes root.', copy: pt ? 'Em 1899, o nascimento de José Pansonatto Filho situa a família em Capivari. Os registros de nascimento, casamento e óbito permitem seguir os laços entre gerações. A estação fotografada é posterior à chegada da família.' : 'By 1899, the birth of José Pansonatto Filho places the family in Capivari. Births, marriages, and deaths let us follow the connections between generations. The station building in this photograph postdates the family’s arrival.' },
].filter(stage => mediaById[stage.mediaId]);
const stages = Object.fromEntries(stageItems.map(stage => [stage.key, stage]));
const firstStage = stageItems[0];
const firstStageMedia = firstStage ? getMedia(firstStage.mediaId, locale) : hero;
const sources = getSources(locale);
const stories = getFeatures(locale);
const featuredStory = stories.find(story => story.id === 'fosca-six-children-at-sea') ?? stories.find(story => story.id === 'eight-names-one-ledger') ?? stories[0];
const featuredVoice = stories.find(story => story.id === 'lm-between-languages') ?? stories.find(story => story.quote && story.id !== featuredStory?.id);
const featuredStoryMedia = featuredStory?.media[0];
const collections = getHistoricalCollections(locale);
const homeUsedMediaIds = new Set([hero.id, ...chapters.map(chapter => chapter.media.id), ...stageItems.map(stage => stage.mediaId), ...(featuredStory?.media.map(item => item.id) ?? [])]);
const homeCollections = collections.filter(collection => !homeUsedMediaIds.has(collection.cover.id)).slice(0, 3);
if (collections.length && homeCollections.length < 3) throw new Error('Homepage needs three collection covers distinct from its other image placements');
const featuredPeople = people.filter(person => ['giuseppe-giacomo-panzonato', 'fosca-moro', 'jose-pansonatto-filho', 'assumpta-elvira-pessato'].includes(person.id));
const rosterPeople: Record<string, ReturnType<typeof getPeople>[number] | undefined> = {
  Giuseppe: people.find(person => person.id === 'giuseppe-giacomo-panzonato'),
  Fosca: people.find(person => person.id === 'fosca-moro'),
  Catarina: people.find(person => person.id === 'catharina-pansonato'),
  Luigi: people.find(person => person.id === 'luiz-pansonatto'),
};
const passengers: [string, string][] = [['Giuseppe', '35'], ['Fosca', '30'], ['Luigia', '10'], ['Catarina', '9'], ['Candida', '7'], ['Luigi', '5'], ['Domenico', '3'], ['Eugenio', '1']];
const crisisMoments = (pt ? [
  { date: '03.11.1891', label: 'Contexto nacional documentado', title: 'Deodoro dissolve o Congresso.', copy: 'O Decreto nº 641 dissolve o Congresso; o governo também impõe estado de sítio na capital. Nesse momento, a família provavelmente ainda cruzava o Atlântico.', mediaId: 'deodoro-da-fonseca-1891' },
  { date: '20.11.1891', label: 'Cronologia reconstruída', title: 'O Colombo teria entrado na Guanabara.', copy: 'A data vem da pesquisa de movimento portuário citada no novo dossiê. O documento da família confirma “procedente do Rio de Janeiro”, mas não registra o dia de entrada na baía.', mediaId: 'rio-port-customs-ferrez' },
  { date: '23.11.1891 · 09h', label: 'Contexto nacional documentado', title: 'A esquadra impõe um ultimato.', copy: 'Custódio José de Melo lidera o movimento naval. O Riachuelo ameaça a capital. A presença dos Panzonato nesse cenário depende de a chegada proposta de 20 de novembro estar correta.', mediaId: 'riachuelo-ferrez-1891' },
  { date: '23.11.1891 · 15h', label: 'Contexto nacional documentado', title: 'Deodoro renuncia; Floriano assume.', copy: 'Floriano Peixoto revoga a dissolução do Congresso pelo Decreto nº 686. A crise é certa; seu efeito operacional exato sobre o Colombo ainda precisa de prova direta.', mediaId: 'floriano-peixoto-1891' },
] : [
  { date: '03 Nov 1891', label: 'Documented national context', title: 'Deodoro dissolves Congress.', copy: 'Decree no. 641 dissolves Congress; the government also imposes a state of siege in the capital. At this point, the family was probably still crossing the Atlantic.', mediaId: 'deodoro-da-fonseca-1891' },
  { date: '20 Nov 1891', label: 'Reconstructed chronology', title: 'The Colombo may have entered Guanabara.', copy: 'The date comes from port-movement research cited in the new dossier. The family entry confirms “from Rio de Janeiro” but does not record the day the ship entered the bay.', mediaId: 'rio-port-customs-ferrez' },
  { date: '23 Nov 1891 · 09:00', label: 'Documented national context', title: 'The fleet delivers an ultimatum.', copy: 'Custódio José de Melo leads the naval movement. The Riachuelo threatens the capital. The Panzonatos’ presence in this scene depends on the proposed 20 November arrival being correct.', mediaId: 'riachuelo-ferrez-1891' },
  { date: '23 Nov 1891 · 15:00', label: 'Documented national context', title: 'Deodoro resigns; Floriano takes office.', copy: 'Floriano Peixoto revokes the dissolution of Congress through Decree no. 686. The crisis is certain; its exact operational effect on the Colombo still needs direct evidence.', mediaId: 'floriano-peixoto-1891' },
]).map(moment => ({ ...moment, media: getMedia(moment.mediaId, locale) }));
const payload = exhibitionPayload(locale, media, chapters.map((chapter, index) => ({
  number: String(index + 1).padStart(2, '0'),
  title: chapter.data.question,
  copy: chapter.data.summary,
  mediaId: chapter.data.mediaId,
  href: chapter.href,
})), stages);
---

<BaseLayout locale={locale} title={t.homeTitle} description={t.homeDescription} alternateHref={route(otherLocale(locale))}>
  <section class="opening" id="opening" aria-labelledby="opening-title">
    <div class="overline"><span>{t.openingOverline[0]}</span><span>{t.openingOverline[1]}</span></div>
    <h1 id="opening-title">{t.openingTitle}<br /><em>{t.openingEmphasis}</em></h1>
    <div class="opening-intro">
      <p>{t.openingIntro}</p>
      <a class="underlined-action" href={featuredStory ? '#home-voice-title' : '#chapters'}>{t.begin}<span aria-hidden="true"></span></a>
    </div>
    <figure class="hero-figure">
      <a class="image-open opening-image-open" href={hero.href} data-evidence="genoa" data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${hero.title}`}>
        <MediaImage media={hero} sizes="(min-width: 1000px) 92vw, 100vw" loading="eager" fetchpriority="high" />
      </a>
      <figcaption><span>{hero.title}</span><span>{hero.caption}</span></figcaption>
    </figure>
  </section>

  {featuredStory && <section class="home-voice" aria-labelledby="home-voice-title">
    <div class="home-voice-heading"><span class="eyebrow">{t.wordsFromArchive}</span><h2 id="home-voice-title">{t.storiesTitle}</h2><p>{t.storiesIntro}</p></div>
    <div class="home-voice-body">
      {featuredStoryMedia && <figure><a class="image-open" href={featuredStoryMedia.href} data-evidence={featuredStoryMedia.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${featuredStoryMedia.title}`}><MediaImage media={featuredStoryMedia} sizes="(min-width: 900px) 42vw, 94vw" /></a><figcaption>{featuredStoryMedia.caption}</figcaption></figure>}
      <article>
        <span class="eyebrow">{featuredStory.period} · {t.featureKinds[featuredStory.kind]}</span>
        <h3>{featuredStory.title}</h3>
        {featuredStory.quote ? <><blockquote lang={featuredStory.quote.originalLang}>{featuredStory.quote.original}</blockquote><p class="home-voice-citation">{featuredStory.quote.speaker} · {featuredStory.quote.citation}</p></> : <p>{featuredStory.dek}</p>}
        <p>{featuredStory.context}</p>
        <a class="text-link" href={featuredStory.href}>{t.readStory}<span aria-hidden="true"></span></a>
      </article>
    </div>
    {featuredVoice?.quote && <article class="home-voice-secondary">
      <div><span class="eyebrow">{featuredVoice.attribution}</span><h3>{featuredVoice.title}</h3></div>
      <div><blockquote lang={featuredVoice.quote.originalLang}>{featuredVoice.quote.original}</blockquote><p>{featuredVoice.quote.citation}</p><a class="text-link" href={featuredVoice.href}>{t.readStory}<span aria-hidden="true"></span></a></div>
    </article>}
    <a class="home-section-link" href={route(locale, 'stories')}>{t.allStories} · {stories.length}</a>
  </section>}

  <section class="chapters" id="chapters" aria-labelledby="chapters-title">
    <div class="section-heading">
      <span class="eyebrow">{t.storyEyebrow}</span>
      <h2 id="chapters-title">{t.storyTitle}<br /><em>{t.storyEmphasis}</em></h2>
      <p>{t.storyIntro}</p>
    </div>
    <div class="chapter-layout">
      <div class="chapter-list" aria-label={t.chapterGroup}>
        {chapters.map((chapter, index) => (
          <a href={chapter.href} data-chapter={String(index)} data-selected={index === 0 ? 'true' : 'false'}>
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{chapter.data.title}</strong><b aria-hidden="true"></b>
          </a>
        ))}
      </div>
      {initialChapter && <div class="chapter-preview" aria-live="polite">
        <span class="eyebrow" id="chapter-number">{t.chapter} {String(initialChapter.data.order).padStart(2, '0')}</span>
        <h3 id="chapter-title">{initialChapter.data.question}</h3>
        <p id="chapter-copy">{initialChapter.data.summary}</p>
        <figure class="chapter-preview-image">
          <a class="image-open" id="chapter-preview-source" href={initialMedia.href} data-evidence={initialMedia.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${initialMedia.title}`}><img id="chapter-image" src={initialMedia.src} srcset={initialMedia.srcset} sizes="(min-width: 900px) 35vw, 90vw" width={initialMedia.width} height={initialMedia.height} alt={initialMedia.alt} loading="lazy" decoding="async" style={`object-position:${initialMedia.focalPoint}`} /></a>
          <figcaption>{initialMedia.caption}</figcaption>
        </figure>
        <a class="text-link" id="chapter-link" href={initialChapter.href}>{t.readChapter}<span aria-hidden="true"></span></a>
      </div>}
    </div>
    <article class="reading manifest-reading" id="crossing-voyage" aria-labelledby="reading-title">
      <div class="reading-meta"><span>{pt ? 'Um documento, uma família' : 'One record, one family'}</span><span>15.12.1891</span></div>
      <div class="voyage-reading-heading">
        <h2 id="reading-title">{pt ? 'Oito nomes.' : 'Eight names.'}<br /><em>{pt ? 'Uma travessia.' : 'One crossing.'}</em></h2>
        <p class="lead">{pt ? 'Giuseppe e Fosca chegaram ao Brasil com seis crianças. A mais velha tinha dez anos. O caçula, apenas um.' : 'Giuseppe and Fosca arrived in Brazil with six children. The eldest was ten. The youngest was just one.'}</p>
      </div>
      <div class="voyage-reading-layout">
        <VoyageMap locale={locale} />
        <div class="voyage-roster">
          <dl class="passenger-roster">{passengers.map(([name, age]) => {
            const person = rosterPeople[name];
            return <div><dt>{person ? <a href={person.href} aria-label={`${name} — ${pt ? 'abrir perfil biográfico' : 'open biographical profile'}`}>{name}</a> : name}</dt><dd>{age} <span>{pt ? (age === '1' ? 'ano' : 'anos') : (age === '1' ? 'year' : 'years')}</span></dd></div>;
          })}</dl>
          <p class="roster-note">{pt ? 'Nomes e idades conforme o registro de chegada do Colombo. Hospedaria de Imigrantes, livro 031, página 283.' : 'Names and ages as recorded in the Colombo arrival entry. Hospedaria de Imigrantes, book 031, page 283.'}</p>
          <a class="text-link" href={crossing.href}>{t.readingLink}<span aria-hidden="true"></span></a>
        </div>
      </div>
      <section class="guanabara-dossier" aria-labelledby="guanabara-title">
        <header>
          <span class="eyebrow">{pt ? 'Rio de Janeiro · novembro de 1891' : 'Rio de Janeiro · November 1891'}</span>
          <h3 id="guanabara-title">{pt ? 'Uma família diante de uma República em crise.' : 'One family beside a republic in crisis.'}</h3>
          <p>{pt ? 'A sequência abaixo separa o que os decretos e a história política documentam daquilo que a cronologia do Colombo ainda reconstrói. Essa diferença não enfraquece a história: mostra exatamente onde termina o arquivo e começa a hipótese.' : 'The sequence below separates what the decrees and political history document from what the Colombo chronology still reconstructs. That distinction does not weaken the story; it shows precisely where the archive ends and hypothesis begins.'}</p>
        </header>
        <div class="guanabara-sequence">
          {crisisMoments.map((moment, index) => <article>
            <a class="image-open" href={moment.media.href} data-evidence={moment.media.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${moment.media.title}`}>
              <MediaImage media={moment.media} sizes="(min-width: 1000px) 21vw, (min-width: 600px) 45vw, 92vw" />
            </a>
            <div><span class="guanabara-index">{String(index + 1).padStart(2, '0')}</span><time>{moment.date}</time><small>{moment.label}</small><h4>{moment.title}</h4><p>{moment.copy}</p></div>
          </article>)}
        </div>
        <div class="guanabara-conclusion">
          <p><strong>{pt ? '24 de novembro–início de dezembro:' : '24 November–early December:'}</strong> {pt ? 'bloqueio de circulação, desorganização alfandegária, greve ferroviária e quarentena são explicações possíveis para a demora — ainda não causas comprovadas para este navio.' : 'restricted movement, customs disruption, railway strikes, and quarantine are possible explanations for the delay—not yet proven causes for this vessel.'}</p>
          <p><strong>{pt ? '15 de dezembro:' : '15 December:'}</strong> {pt ? 'o registro do Brás oferece o próximo ponto seguro. Os oito nomes chegaram juntos à página 283.' : 'the Brás register supplies the next secure point. All eight names reached page 283 together.'}</p>
        </div>
      </section>
    </article>
  </section>

  {firstStage && <section class="journey" id="journey" aria-labelledby="journey-title">
    <div class="journey-top"><span id="journey-title">{pt ? 'Explore os lugares' : 'Explore the places'}</span><span>{t.journeyHint}</span></div>
    <div class="stage-selector" aria-label={t.stageGroup}>
      {stageItems.map((stage, index) => <>{index > 0 && <i aria-hidden="true"></i>}<a href={getMedia(stage.mediaId, locale).href} data-stage={stage.key} data-selected={index === 0 ? 'true' : 'false'}><span>{stage.country}</span>{stage.name}</a></>)}
    </div>
    <div class="stage-view">
      <figure><a class="image-open stage-image-open" href={firstStageMedia.href} data-evidence={firstStageMedia.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${firstStageMedia.title}`}><MediaImage media={firstStageMedia} class="stage-photo" sizes="(min-width: 900px) 62vw, 100vw" /></a><figcaption class="stage-caption">{firstStageMedia.caption}</figcaption></figure>
      <div class="stage-copy" aria-live="polite"><span class="eyebrow">{firstStage.eyebrow}</span><h2>{firstStage.title}</h2><p>{firstStage.copy}</p><a class="look-closer" href={firstStageMedia.href} data-evidence={firstStageMedia.id}>{t.lookCloser}<span aria-hidden="true"></span></a></div>
    </div>
    <p class="interaction-status" role="status" aria-live="polite"></p>
  </section>}

  <Timeline locale={locale} />

  {homeCollections.length > 0 && <section class="home-collections" aria-labelledby="home-collections-title">
    <div class="home-collections-heading"><span class="eyebrow">{t.collectionEssay}</span><h2 id="home-collections-title">{t.collectionsTitle}</h2><p>{t.collectionsIntro}</p></div>
    <div class="home-collection-entrances">{homeCollections.map((collection, index) => <article class={`home-collection-${index + 1}`}><a href={collection.href}><figure><MediaImage media={collection.cover} sizes="(min-width: 900px) 38vw, 90vw" /><figcaption>{collection.cover.caption}</figcaption></figure><span class="eyebrow">{collection.period} · {collection.media.length} {t.photographs}</span><h3>{collection.title}</h3></a></article>)}</div>
    <a class="home-section-link" href={route(locale, 'collections')}>{t.allCollections} · {collections.length}</a>
  </section>}

  <section class="home-people" id="people">
    <div><span class="eyebrow">{t.nav.people}</span><h2>{t.peopleTitle}</h2><p>{t.peopleCopy}</p><a class="text-link" href={route(locale, 'people')}>{t.meetPeople}<span aria-hidden="true"></span></a></div>
    <div class="home-people-list">{(featuredPeople.length >= 4 ? featuredPeople : people.slice(0, 4)).map(person => <a href={person.href}><span>{person.dates ?? t.profile}</span><h3>{person.name}</h3></a>)}</div>
  </section>

  <section class="archive-entrance" id="archive">
    <span class="eyebrow">{t.archiveSelected}</span><h2>{t.archiveSelectedTitle}</h2>
    <p>{t.archiveCopy}</p>
    <a class="text-link" href={route(locale, 'archive')}>{t.exploreArchive} · {sources.length}<span aria-hidden="true"></span></a>
  </section>

  <EvidenceDialog locale={locale} initial={hero} />
  <script id="exhibition-data" type="application/json" is:inline set:html={safeJson(payload)}></script>
</BaseLayout>
