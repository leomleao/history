---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EvidenceDialog from '../../../../components/EvidenceDialog.astro';
import MediaImage from '../../../../components/MediaImage.astro';
import { getChapters, getFeatures, locales, otherLocale, route, type Locale } from '../../../../lib/content';
import { exhibitionPayload, safeJson, strings } from '../../../../lib/ui';

export function getStaticPaths() {
  return locales.flatMap(locale => getFeatures(locale).map(story => ({ params: { locale, id: story.id }, props: { locale, story } })));
}
const { locale, story } = Astro.props as { locale: Locale; story: ReturnType<typeof getFeatures>[number] };
const t = strings(locale);
const chapter = (await getChapters(locale)).find(item => item.data.key === story.chapterKey);
const stories = getFeatures(locale);
const storyIndex = stories.findIndex(item => item.id === story.id);
const next = stories[(storyIndex + 1) % stories.length];
const lead = story.media[0];
const originalLanguage = story.quote?.originalLang.toLowerCase();
const showTranslation = story.quote && story.quote.translation.trim() !== story.quote.original.trim() && !(originalLanguage?.startsWith('pt') && locale === 'pt-br') && !(originalLanguage?.startsWith('en') && locale === 'en');
---

<BaseLayout locale={locale} title={story.title} description={story.dek} alternateHref={route(otherLocale(locale), 'stories', story.id)} current="stories">
  <article class="story-detail">
    <header class="story-hero">
      <Breadcrumbs label={t.breadcrumbLabel} items={[{ label: t.breadcrumbHome, href: route(locale) }, { label: t.allStories, href: route(locale, 'stories') }, { label: story.title }]} />
      <div class="story-hero-copy">
        <span class="eyebrow">{t.featureKinds[story.kind]} · {story.period}</span>
        <h1>{story.title}</h1>
        <p class="story-dek">{story.dek}</p>
        <p class="story-attribution">{story.attribution}</p>
      </div>
      {lead && <figure class="story-lead-image"><a class="image-open" href={lead.href} data-evidence={lead.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${lead.title}`}><MediaImage media={lead} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 48vw, 100vw" /></a><figcaption>{lead.caption}</figcaption></figure>}
    </header>

    <div class="story-reading-layout">
      <aside class="story-context"><span class="eyebrow">{t.story}</span><p>{story.context}</p>{chapter && <a class="text-link" href={chapter.href}>{t.relatedChapter}<span aria-hidden="true"></span></a>}</aside>
      <div class="story-reading">
        {story.quote && <figure class="archive-quote">
          <figcaption>{t.wordsFromArchive}</figcaption>
          <span class="quote-label">{t.originalExcerpt}</span>
          <blockquote lang={story.quote.originalLang}>{story.quote.original}</blockquote>
          <p class="quote-speaker">{story.quote.speaker}</p>
          {showTranslation && <details class="translation-toggle"><summary>{t.showTranslation}</summary><blockquote>{story.quote.translation}</blockquote></details>}
          <cite>{story.quote.citation}</cite>
        </figure>}
        <div class="prose story-prose">{story.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
      </div>
    </div>

    {story.media.length > 1 && <section class="story-media" aria-labelledby="story-media-title"><span class="eyebrow" id="story-media-title">{t.galleryTitle}</span><div class="essay-grid">{story.media.slice(1).map((media, index) => <figure class:list={[`essay-item-${index + 1}`]}><a class="image-open" href={media.href} data-evidence={media.id} data-inspect-label={t.inspect} aria-label={`${t.inspect}: ${media.title}`}><MediaImage media={media} sizes="(min-width: 900px) 44vw, 100vw" /></a><figcaption>{media.caption}</figcaption></figure>)}</div></section>}

    <section class="story-sources"><span class="eyebrow">{t.storySources}</span><ol class="story-source-list">{story.sources.map(source => <li><a href={source.href}><strong>{source.title}</strong><span>{source.citation}</span></a></li>)}</ol></section>
    {(next || chapter) && <nav class="discovery-nav" aria-label={t.moreStories}>{chapter && <a href={chapter.href}><span>{t.relatedChapter}</span><strong>{chapter.data.title}</strong></a>}{next && <a href={next.href}><span>{t.moreStories}</span><strong>{next.title}</strong></a>}</nav>}
  </article>
  {lead && <><EvidenceDialog locale={locale} initial={lead} /><script id="exhibition-data" type="application/json" is:inline set:html={safeJson(exhibitionPayload(locale, story.media))}></script></>}
</BaseLayout>
