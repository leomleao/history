---
import type { Locale } from '../lib/content';
import { route } from '../lib/content';
import { strings } from '../lib/ui';

interface Props {
  locale: Locale;
  alternateHref: string;
  current?: 'chapters' | 'people' | 'archive' | 'about';
}

const { locale, alternateHref, current } = Astro.props;
const t = strings(locale);
---

<header class="site-header">
  <a class="wordmark" href={route(locale)} aria-label={`${t.siteName}, ${t.breadcrumbHome}`}>
    {t.siteName} <span>{t.siteDescriptor}</span>
  </a>
  <nav aria-label={t.navLabel}>
    <a href={route(locale, 'chapters')} aria-current={current === 'chapters' ? 'page' : undefined}>{t.nav.chapters}</a>
    <a href={route(locale, 'people')} aria-current={current === 'people' ? 'page' : undefined}>{t.nav.people}</a>
    <a href={route(locale, 'archive')} aria-current={current === 'archive' ? 'page' : undefined}>{t.nav.archive}</a>
    <a href={route(locale, 'about')} aria-current={current === 'about' ? 'page' : undefined}>{t.nav.about}</a>
  </nav>
  <a class="language-switch" href={alternateHref} hreflang={locale === 'en' ? 'pt-BR' : 'en'} lang={locale === 'en' ? 'pt-BR' : 'en'} aria-label={t.languageLabel}>{t.language}</a>
</header>
